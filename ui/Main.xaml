<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="SLT Smart PC Boost v1.0.0  |  Smart Life Teck  |  Developed by Shahzad Babar" Width="1380" Height="860" WindowState="Maximized"
        MinWidth="1040" MinHeight="660" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}" FontFamily="Inter, Space Grotesk, Segoe UI" FontSize="13">
 <Window.Resources>
  <!-- SINGLE VARIABLE CONTROL FOR ALL 8 THEMES (Default = Theme 1: SLT Smart Tools - Emerald Dark) -->
  <SolidColorBrush x:Key="WindowBg" Color="#0E2A22"/>
  <SolidColorBrush x:Key="SidebarBg" Color="#0A1F18"/>
  <SolidColorBrush x:Key="SidebarBorder" Color="#2E6F5A"/>
  <SolidColorBrush x:Key="Panel" Color="#15463A"/>
  <SolidColorBrush x:Key="PanelBorder" Color="#2E6F5A"/>
  <SolidColorBrush x:Key="CardSurface" Color="#15463A"/>
  <SolidColorBrush x:Key="CardDeep" Color="#0F3429"/>
  <SolidColorBrush x:Key="CardBorder" Color="#2E6F5A"/>
  <SolidColorBrush x:Key="InputBg" Color="#0F3429"/>
  <SolidColorBrush x:Key="InputBorder" Color="#357F67"/>
  <SolidColorBrush x:Key="FooterBg" Color="#0A1F18"/>
  <SolidColorBrush x:Key="LogBg" Color="#0A1F18"/>
  <SolidColorBrush x:Key="LogFg" Color="#F7EFE0"/>
  <SolidColorBrush x:Key="TextPrimary" Color="#F7EFE0"/>
  <SolidColorBrush x:Key="TextSecondary" Color="#BFE0D2"/>
  <SolidColorBrush x:Key="TextAccent" Color="#ECC95A"/>
  <SolidColorBrush x:Key="BtnBg" Color="#164A3D"/>
  <SolidColorBrush x:Key="BtnText" Color="#F7EFE0"/>
  <SolidColorBrush x:Key="BtnBorder" Color="#327862"/>
  <SolidColorBrush x:Key="BtnHoverBg" Color="#1E5E4E"/>
  <SolidColorBrush x:Key="BtnHoverText" Color="#ECC95A"/>
  <SolidColorBrush x:Key="BtnSelectedBg" Color="#DFBD46"/>
  <SolidColorBrush x:Key="BtnSelectedText" Color="#05140E"/>
  <SolidColorBrush x:Key="NavIdle" Color="#164A3D"/>
  <SolidColorBrush x:Key="NavActive" Color="#DFBD46"/>
  <SolidColorBrush x:Key="NavText" Color="#F7EFE0"/>
  <SolidColorBrush x:Key="NavActiveText" Color="#05140E"/>
  <SolidColorBrush x:Key="NavHover" Color="#1E5E4E"/>
  <SolidColorBrush x:Key="NavHoverText" Color="#ECC95A"/>
  <SolidColorBrush x:Key="ActionPrimary" Color="#164A3D"/>
  <SolidColorBrush x:Key="ActionSecondary" Color="#164A3D"/>
  <SolidColorBrush x:Key="ActionHover" Color="#1E5E4E"/>
  <SolidColorBrush x:Key="ActionText" Color="#F7EFE0"/>
  <SolidColorBrush x:Key="ActionBorder" Color="#327862"/>
  <SolidColorBrush x:Key="SLTStatusOk" Color="#34D399"/>
  <SolidColorBrush x:Key="SLTStatusWarn" Color="#FBBF24"/>
  <SolidColorBrush x:Key="SLTStatusError" Color="#F87171"/>
  <SolidColorBrush x:Key="SLTStatusInfo" Color="#38BDF8"/>
  <CornerRadius x:Key="BtnRadius">12</CornerRadius>
  <CornerRadius x:Key="NavRadius">12</CornerRadius>
  <CornerRadius x:Key="CardRadius">12</CornerRadius>
  <Thickness x:Key="BtnBorderThickness">1</Thickness>
  <sys:Double x:Key="BtnFontSize">12.5</sys:Double>
  <sys:Double x:Key="NavFontSize">12.6</sys:Double>
  <sys:Double x:Key="TitleFontSize">22.0</sys:Double>
  <sys:Double x:Key="BodyFontSize">12.5</sys:Double>

  <!-- UNIFIED .slt-btn STYLE FOR SIDEBAR NAVIGATION BUTTONS -->
  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Height" Value="42"/><Setter Property="Margin" Value="0,3"/>
   <Setter Property="Padding" Value="12,6"/><Setter Property="Background" Value="{DynamicResource BtnBg}"/>
   <Setter Property="Foreground" Value="{DynamicResource BtnText}"/><Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontSize" Value="{DynamicResource NavFontSize}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource BtnRadius}" Padding="{TemplateBinding Padding}">
       <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="bg" Property="Background" Value="{DynamicResource BtnHoverBg}"/>
        <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource BtnSelectedBg}"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- UNIFIED .slt-btn STYLE FOR ALL ACTION BUTTONS (No permanent highlights; only highlights when selected/clicked) -->
  <Style x:Key="ActionButton" TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource BtnBg}"/><Setter Property="Foreground" Value="{DynamicResource BtnText}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="38"/>
   <Setter Property="Padding" Value="16,7"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="{DynamicResource BtnFontSize}"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource BtnRadius}" Padding="{TemplateBinding Padding}">
       <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="body" Property="Background" Value="{DynamicResource BtnHoverBg}"/>
        <Setter TargetName="body" Property="BorderBrush" Value="{DynamicResource BtnSelectedBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource BtnHoverText}"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="body" Property="Opacity" Value="0.5"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- UNIFIED .slt-btn ALIASES (All inherit the exact same single-variable .slt-btn behavior!) -->
  <Style x:Key="GreenPillButton" TargetType="Button" BasedOn="{StaticResource ActionButton}"/>
  <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource ActionButton}"/>
  <Style x:Key="CabinCheckButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
   <Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="12,3"/>
  </Style>

  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource Panel}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}"/>
   <Setter Property="Padding" Value="20"/>
   <Setter Property="Margin" Value="0,6,0,6"/>
  </Style>

  <Style TargetType="TextBox">
   <Setter Property="Background" Value="{DynamicResource InputBg}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="9,5"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="CaretBrush" Value="{DynamicResource TextAccent}"/>
   <Setter Property="SelectionBrush" Value="{DynamicResource BtnSelectedBg}"/>
  </Style>
  <Style TargetType="ToolTip">
   <Setter Property="Background" Value="{DynamicResource CardDeep}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BtnSelectedBg}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="10,6"/>
   <Setter Property="FontSize" Value="11.5"/>
  </Style>

  <Style TargetType="ComboBoxItem">
   <Setter Property="Background" Value="{DynamicResource CardSurface}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
   <Setter Property="Padding" Value="10,7"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SidebarBorder}">
       <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontWeight="SemiBold"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnHoverBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource BtnHoverText}"/>
       </Trigger>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnSelectedBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource BtnSelectedText}"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style TargetType="ComboBox">
   <Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="8,4"/><Setter Property="MinWidth" Value="120"/><Setter Property="Height" Value="34"/>
   <Setter Property="Background" Value="{DynamicResource BtnBg}"/><Setter Property="Foreground" Value="{DynamicResource BtnText}"/><Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="11.5"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Grid>
       <ToggleButton x:Name="ToggleButton" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
        <ToggleButton.Template>
         <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource BtnRadius}">
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Path=Text, RelativeSource={RelativeSource AncestorType=ComboBox}}" Foreground="{DynamicResource BtnText}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,2,0" TextTrimming="CharacterEllipsis"/>
            <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource TextAccent}"/>
           </Grid>
          </Border>
         </ControlTemplate>
        </ToggleButton.Template>
       </ToggleButton>
       <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
        <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320">
         <Border x:Name="DropDownBorder" Background="{DynamicResource CardSurface}" BorderThickness="1.5" BorderBrush="{DynamicResource BtnSelectedBg}" CornerRadius="{DynamicResource BtnRadius}" Padding="2">
          <ScrollViewer Margin="2" SnapsToDevicePixels="True"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
         </Border>
        </Grid>
       </Popup>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Margin" Value="8,6"/></Style>
 </Window.Resources>

 <!-- 2-COLUMN LAYOUT: Left Sidebar (260px) + Right Workspace with Radial Glow -->
 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="260"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

  <!-- LEFT SIDEBAR -->
  <Border Grid.Column="0" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,0,1,0">
   <DockPanel Margin="16,20,16,14">
    <!-- Top Brand Block -->
    <StackPanel DockPanel.Dock="Top" Margin="2,0,2,20">
     <StackPanel Orientation="Horizontal">
      <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource BtnBg}" BorderBrush="{DynamicResource BtnBorder}" BorderThickness="1" Margin="0,0,12,0">
       <Grid>
        <Image x:Name="BrandLogo" Height="34" Width="34" Stretch="Uniform" Visibility="Visible"/>
       </Grid>
      </Border>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="SLT Smart PC Boost" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextAccent}"/>
       <TextBlock Text="POWERFUL  .  CLEAN  ." Foreground="{DynamicResource TextSecondary}" FontSize="9.5" FontWeight="SemiBold" Margin="0,2,0,0"/>
       <TextBlock Text="SIMPLE" Foreground="{DynamicResource TextSecondary}" FontSize="9.5" FontWeight="SemiBold"/>
      </StackPanel>
     </StackPanel>
    </StackPanel>

    <!-- Bottom System Protected Card (Normal .slt-btn style, not permanently highlighted!) & Theme Selector -->
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
     <Border x:Name="SystemProtectedCard" Background="{DynamicResource BtnBg}" BorderBrush="{DynamicResource BtnBorder}" BorderThickness="1" CornerRadius="{DynamicResource BtnRadius}" Padding="14,11" Cursor="Hand">
      <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
      <StackPanel>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
        <Canvas Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center">
         <Path Data="M12 8c0 3.2-2.2 4.8-4.8 5.7a.6.6 0 0 1-.4 0C4.2 12.8 2 11.2 2 8V3.6a.6.6 0 0 1 .6-.6c1.2 0 2.8-.7 3.9-1.7a.7.7 0 0 1 .9 0C8.5 2.3 10.1 3 11.4 3a.6.6 0 0 1 .6.6z" Stroke="{DynamicResource TextAccent}" StrokeThickness="1.6"/>
        </Canvas>
        <TextBlock x:Name="SysProtTitle" Text="System Protected" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BtnText}" VerticalAlignment="Center"/>
       </StackPanel>
       <TextBlock Text="Developed by Shahzad Babar" FontSize="10.2" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
       <TextBlock Text="Smart Life Teck - Saudi Arabia" FontSize="10.2" Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,0"/>
       <TextBlock Text="www.smartlifeteck.com" FontSize="10.2" Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,0"/>
       <TextBlock Text="Email: smartlifeteck@gmail.com" FontSize="10.2" Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,0"/>
                        <TextBlock Text="WhatsApp: +966 55 376 0854" FontSize="10.2" Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,0"/>
      </StackPanel>
     </Border>
     <ComboBox x:Name="ThemeSelector" Margin="0,10,0,4" ToolTip="Switch UI Theme (8 Eye-Care Themes: 4 Dark + 4 Light)"/>
     <TextBlock x:Name="SidebarThemeSubText" Text="v1.0.0 . 8 Eye-Care Themes . Smart Life Teck" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="2,2,0,0"/>
    </StackPanel>

    <!-- Navigation Items -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="Both">
     <StackPanel x:Name="NavPanel"/>
    </ScrollViewer>
   </DockPanel>
  </Border>

  <!-- RIGHT MAIN WORKSPACE (Dynamic WindowBg + Radial Glow 15% -10% + Two-Finger Smooth Touchpad Scrolling) -->
  <Grid x:Name="WorkspaceGrid" Grid.Column="1" Background="{DynamicResource WindowBg}">
   <Rectangle x:Name="WorkspaceRadialGlow" Height="620" VerticalAlignment="Top" HorizontalAlignment="Stretch" IsHitTestVisible="False">
    <Rectangle.Fill>
     <RadialGradientBrush GradientOrigin="0.15,0.0" Center="0.15,0.05" RadiusX="0.72" RadiusY="0.85">
      <GradientStop x:Name="RadialGlowStop" Color="#CC1A5443" Offset="0.0"/>
      <GradientStop x:Name="RadialGlowEnd" Color="#000E2A22" Offset="1.0"/>
     </RadialGradientBrush>
    </Rectangle.Fill>
   </Rectangle>

   <ScrollViewer x:Name="WorkspaceScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="Both" IsManipulationEnabled="True" CanContentScroll="False" Focusable="True" Padding="28,22,28,22">
    <ContentControl x:Name="PageHost" MaxWidth="1240" Focusable="False"/>
   </ScrollViewer>

   <!-- Hidden compatibility controls -->
   <Border x:Name="HeaderBorder" Visibility="Collapsed" Height="90">
    <Border.Background>
     <LinearGradientBrush>
      <GradientStop x:Name="HeaderStop1" Color="#0E2A22" Offset="0"/>
      <GradientStop x:Name="HeaderStop2" Color="#15463A" Offset="0.5"/>
      <GradientStop x:Name="HeaderStop3" Color="#0A1F18" Offset="1"/>
     </LinearGradientBrush>
    </Border.Background>
    <StackPanel>
     <TextBlock x:Name="PageTitle" Text="Dashboard"/>
     <TextBlock x:Name="PageSubtitle" Text=""/>
     <TextBlock x:Name="HelpBox" Text=""/>
     <TextBox x:Name="LogBox" IsReadOnly="True"/>
     <GridSplitter Height="0" Visibility="Collapsed"/>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
